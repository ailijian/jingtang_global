{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jingtang:contract:content:content:v1",
  "title": "Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_id",
    "workspace_id",
    "internal_title",
    "status",
    "current_revision_id",
    "current_revision_number",
    "created_by_user_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "content_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "internal_title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "type": "string", "enum": ["draft", "pending_approval", "rejected", "approved"] },
    "current_revision_id": { "type": "string", "format": "uuid" },
    "current_revision_number": { "type": "integer", "minimum": 1 },
    "created_by_user_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
