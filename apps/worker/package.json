{
  "name": "@jingtang/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "dev": "node --use-env-proxy --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node --use-env-proxy dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@jingtang/application": "workspace:*",
    "@jingtang/db": "workspace:*",
    "@jingtang/integrations": "workspace:*",
    "@jingtang/observability": "workspace:*"
  }
}
