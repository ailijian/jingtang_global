generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN    @map("en")
  ZH_CN @map("zh-CN")

  @@map("locale")
}

enum Role {
  OWNER_ADMIN        @map("owner_admin")
  EDITOR             @map("editor")
  APPROVER_PUBLISHER @map("approver_publisher")
  VIEWER             @map("viewer")

  @@map("role")
}

enum MembershipStatus {
  ACTIVE  @map("active")
  REMOVED @map("removed")

  @@map("membership_status")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")

  @@map("invitation_status")
}

enum ChannelState {
  NOT_CONNECTED            @map("not_connected")
  CONNECTING               @map("connecting")
  CONNECTED                @map("connected")
  REAUTHORIZATION_REQUIRED @map("reauthorization_required")
  DISCONNECTING            @map("disconnecting")
  DISCONNECTED             @map("disconnected")

  @@map("channel_state")
}

enum ContentStatus {
  DRAFT            @map("draft")
  PENDING_APPROVAL @map("pending_approval")
  REJECTED         @map("rejected")
  APPROVED         @map("approved")

  @@map("content_status")
}

enum SourceAssetStatus {
  PENDING_UPLOAD @map("pending_upload")
  COMPLETE       @map("complete")
  FAILED         @map("failed")

  @@map("source_asset_status")
}

enum Platform {
  YOUTUBE @map("youtube")

  @@map("platform")
}

enum PrivacyStatus {
  PRIVATE  @map("private")
  UNLISTED @map("unlisted")
  PUBLIC   @map("public")

  @@map("privacy_status")
}

enum ValidationStatus {
  VALID   @map("valid")
  INVALID @map("invalid")

  @@map("validation_status")
}

enum ApprovalResult {
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("approval_result")
}

enum PublishingIntentState {
  NONE      @map("none")
  READY     @map("ready")
  SCHEDULED @map("scheduled")
  CANCELLED @map("cancelled")

  @@map("publishing_intent_state")
}

enum PublishingMode {
  IMMEDIATE @map("immediate")
  SCHEDULED @map("scheduled")

  @@map("publishing_mode")
}

enum PlatformExecutionState {
  NOT_STARTED     @map("not_started")
  PUBLISHING      @map("publishing")
  PROCESSING      @map("processing")
  PUBLISHED       @map("published")
  FAILED          @map("failed")
  NEEDS_ATTENTION @map("needs_attention")
  CANCELLED       @map("cancelled")

  @@map("platform_execution_state")
}

enum OutboxState {
  PENDING     @map("pending")
  DISPATCHING @map("dispatching")
  DISPATCHED  @map("dispatched")
  CLAIMED     @map("claimed")
  COMPLETED   @map("completed")
  DEAD        @map("dead")

  @@map("outbox_state")
}

enum WorkspaceLifecycleState {
  ACTIVE           @map("active")
  DELETION_PENDING @map("deletion_pending")
  DELETED          @map("deleted")

  @@map("workspace_lifecycle_state")
}

enum DataDeletionState {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("data_deletion_state")
}

enum LifecycleOperationKind {
  CHANNEL_DISCONNECT        @map("channel_disconnect")
  WORKSPACE_DATA_DELETION   @map("workspace_data_deletion")
  ACCOUNT_DELETION          @map("account_deletion")
  AUTHORIZED_DATA_RETENTION @map("authorized_data_retention")
  RETENTION_PURGE           @map("retention_purge")
  TOKEN_KEY_RETIREMENT      @map("token_key_retirement")

  @@map("lifecycle_operation_kind")
}

enum LifecycleOperationState {
  PENDING   @map("pending")
  CLAIMED   @map("claimed")
  RETRY     @map("retry")
  COMPLETED @map("completed")
  DEAD      @map("dead")

  @@map("lifecycle_operation_state")
}

enum LifecycleStepState {
  PENDING   @map("pending")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  SKIPPED   @map("skipped")

  @@map("lifecycle_step_state")
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  cognitoSubject      String             @unique @map("cognito_subject") @db.VarChar(255)
  email               String             @unique @db.VarChar(320)
  name                String             @db.VarChar(160)
  localePreference    Locale             @default(EN) @map("locale_preference")
  lastWorkspaceId     String?            @map("last_workspace_id") @db.Uuid
  lifecycleState      String             @default("active") @map("lifecycle_state") @db.VarChar(32)
  deletionRequestedAt DateTime?          @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships         Membership[]
  sessions            Session[]
  consents            ConsentRecord[]
  createdWorkspaces   Workspace[]        @relation("WorkspaceCreator")
  invitedMembers      Invitation[]       @relation("InvitationActor")
  auditEvents         AuditEvent[]       @relation("AuditActor")
  uploadedAssets      SourceAsset[]      @relation("SourceAssetUploader")
  createdContents     Content[]          @relation("ContentCreator")
  createdRevisions    ContentRevision[]  @relation("RevisionCreator")
  approvalDecisions   ApprovalDecision[] @relation("ApprovalActor")
  confirmedIntents    PublishingIntent[] @relation("PublishingConfirmer")

  @@map("users")
}

model Workspace {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String                  @db.VarChar(160)
  createdByUserId      String                  @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  lifecycleState       WorkspaceLifecycleState @default(ACTIVE) @map("lifecycle_state")
  deletionRequestedAt  DateTime?               @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(3)
  createdBy            User                    @relation("WorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships          Membership[]
  invitations          Invitation[]
  auditEvents          AuditEvent[]
  channels             Channel[]
  sourceAssets         SourceAsset[]
  contents             Content[]
  contentRevisions     ContentRevision[]
  platformVersions     PlatformVersion[]
  approvalDecisions    ApprovalDecision[]
  publishingIntents    PublishingIntent[]
  platformExecutions   PlatformExecution[]
  outboxMessages       OutboxMessage[]
  dataDeletionRequests DataDeletionRequest[]
  lifecycleOperations  LifecycleOperation[]

  @@index([createdByUserId])
  @@map("workspaces")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        Role
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, role, status])
  @@map("memberships")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  email           String           @db.VarChar(320)
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  role            Role
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationActor", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, email])
  @@map("invitations")
}

model ConsentRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  termsVersion       String    @map("terms_version") @db.VarChar(80)
  privacyVersion     String    @map("privacy_version") @db.VarChar(80)
  dataPurposeVersion String    @map("data_purpose_version") @db.VarChar(80)
  displayedLocale    Locale    @map("displayed_locale")
  acceptanceMethod   String    @map("acceptance_method") @db.VarChar(40)
  acceptedAt         DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  channels           Channel[] @relation("ChannelConsent")

  @@index([userId, acceptedAt])
  @@map("consent_records")
}

model Session {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  tokenHash          String   @unique @map("token_hash") @db.Char(64)
  currentWorkspaceId String?  @map("current_workspace_id") @db.Uuid
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Channel {
  id                       String         @id @default(uuid()) @db.Uuid
  workspaceId              String         @map("workspace_id") @db.Uuid
  platform                 String         @db.VarChar(40)
  externalAccountId        String?        @map("external_account_id") @db.VarChar(255)
  displayName              String?        @map("display_name") @db.VarChar(255)
  state                    ChannelState   @default(NOT_CONNECTED)
  grantedScopes            String[]       @default([]) @map("granted_scopes")
  consentRecordId          String?        @map("consent_record_id") @db.Uuid
  tokenCiphertextReference String?        @map("token_ciphertext_reference") @db.VarChar(500)
  tokenEnvelopeCiphertext  String?        @map("token_envelope_ciphertext") @db.Text
  authorizedAt             DateTime?      @map("authorized_at") @db.Timestamptz(3)
  refreshedAt              DateTime?      @map("refreshed_at") @db.Timestamptz(3)
  deniedAt                 DateTime?      @map("denied_at") @db.Timestamptz(3)
  authorizedDataExpiresAt  DateTime?      @map("authorized_data_expires_at") @db.Timestamptz(3)
  disconnectRequestedAt    DateTime?      @map("disconnect_requested_at") @db.Timestamptz(3)
  disconnectedAt           DateTime?      @map("disconnected_at") @db.Timestamptz(3)
  revokeFailureCategory    String?        @map("revoke_failure_category") @db.VarChar(80)
  revokeAttemptCount       Int            @default(0) @map("revoke_attempt_count")
  operationLeaseId         String?        @map("operation_lease_id") @db.Uuid
  operationLeaseUntil      DateTime?      @map("operation_lease_until") @db.Timestamptz(3)
  operationGeneration      BigInt         @default(0) @map("operation_generation")
  operationLeaseGeneration BigInt?        @map("operation_lease_generation")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consent                  ConsentRecord? @relation("ChannelConsent", fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, platform])
  @@index([workspaceId, state])
  @@map("channels")
}

model SourceAsset {
  id                 String            @id @default(uuid()) @db.Uuid
  workspaceId        String            @map("workspace_id") @db.Uuid
  contentId          String?           @unique @map("content_id") @db.Uuid
  objectKey          String            @unique @map("object_key") @db.VarChar(700)
  originalFilename   String            @map("original_filename") @db.VarChar(255)
  mediaType          String            @map("media_type") @db.VarChar(160)
  byteSize           BigInt            @map("byte_size")
  sha256             String            @db.Char(64)
  status             SourceAssetStatus @default(PENDING_UPLOAD)
  ownershipConfirmed Boolean           @map("ownership_confirmed")
  failureCategory    String?           @map("failure_category") @db.VarChar(80)
  uploadedByUserId   String            @map("uploaded_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content            Content?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  uploadedBy         User              @relation("SourceAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  revisions          ContentRevision[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, uploadedByUserId])
  @@map("source_assets")
}

model Content {
  id                    String             @id @default(uuid()) @db.Uuid
  workspaceId           String             @map("workspace_id") @db.Uuid
  internalTitle         String             @map("internal_title") @db.VarChar(160)
  status                ContentStatus      @default(DRAFT)
  currentRevisionNumber Int                @default(1) @map("current_revision_number")
  createdByUserId       String             @map("created_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy             User               @relation("ContentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceAsset           SourceAsset?
  revisions             ContentRevision[]
  approvalDecisions     ApprovalDecision[]
  publishingIntents     PublishingIntent[]

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@map("contents")
}

model ContentRevision {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  contentId         String             @map("content_id") @db.Uuid
  revisionNumber    Int                @map("revision_number")
  sourceAssetId     String             @map("source_asset_id") @db.Uuid
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content           Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sourceAsset       SourceAsset        @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("RevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  platformVersions  PlatformVersion[]
  approvalDecision  ApprovalDecision?
  publishingIntents PublishingIntent[]

  @@unique([contentId, revisionNumber])
  @@index([workspaceId, contentId, revisionNumber(sort: Desc)])
  @@map("content_revisions")
}

model PlatformVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  revisionId         String              @map("revision_id") @db.Uuid
  platform           Platform
  accountReference   String              @map("account_reference") @db.VarChar(255)
  accountDisplayName String              @map("account_display_name") @db.VarChar(255)
  title              String              @db.VarChar(100)
  description        String              @db.VarChar(5000)
  privacyStatus      PrivacyStatus       @map("privacy_status")
  madeForKids        Boolean             @map("made_for_kids")
  validationStatus   ValidationStatus    @default(VALID) @map("validation_status")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revision           ContentRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  platformExecutions PlatformExecution[]

  @@unique([revisionId, platform, accountReference])
  @@index([workspaceId, revisionId])
  @@map("platform_versions")
}

model ApprovalDecision {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  contentId   String          @map("content_id") @db.Uuid
  revisionId  String          @unique @map("revision_id") @db.Uuid
  actorUserId String          @map("actor_user_id") @db.Uuid
  result      ApprovalResult
  reason      String?         @db.VarChar(1000)
  decidedAt   DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content     Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  revision    ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  actor       User            @relation("ApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, decidedAt(sort: Desc)])
  @@map("approval_decisions")
}

model PublishingIntent {
  id                 String                @id @default(uuid()) @db.Uuid
  workspaceId        String                @map("workspace_id") @db.Uuid
  contentId          String                @map("content_id") @db.Uuid
  revisionId         String                @map("revision_id") @db.Uuid
  platformVersionIds String[]              @map("platform_version_ids") @db.Uuid
  accountReferences  String[]              @map("account_references")
  payloadSnapshot    Json                  @map("payload_snapshot")
  permissionDecision String                @map("permission_decision") @db.VarChar(40)
  state              PublishingIntentState
  mode               PublishingMode
  confirmedByUserId  String                @map("confirmed_by_user_id") @db.Uuid
  consentVersion     String                @map("consent_version") @db.VarChar(80)
  payloadHash        String                @map("payload_hash") @db.Char(64)
  idempotencyKey     String                @map("idempotency_key") @db.VarChar(255)
  confirmedAt        DateTime              @map("confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content            Content               @relation(fields: [contentId], references: [id], onDelete: Restrict)
  revision           ContentRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  confirmedBy        User                  @relation("PublishingConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  executions         PlatformExecution[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, contentId, confirmedAt(sort: Desc)])
  @@map("publishing_intents")
}

model PlatformExecution {
  id                 String                 @id @default(uuid()) @db.Uuid
  workspaceId        String                 @map("workspace_id") @db.Uuid
  publishingIntentId String                 @map("publishing_intent_id") @db.Uuid
  platformVersionId  String                 @map("platform_version_id") @db.Uuid
  operation          String                 @db.VarChar(40)
  attempt            Int
  idempotencyKey     String                 @map("idempotency_key") @db.VarChar(255)
  state              PlatformExecutionState @default(NOT_STARTED)
  failureCategory    String?                @map("failure_category") @db.VarChar(80)
  providerId         String?                @map("provider_id") @db.VarChar(255)
  providerUrl        String?                @map("provider_url") @db.VarChar(1000)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishingIntent   PublishingIntent       @relation(fields: [publishingIntentId], references: [id], onDelete: Cascade)
  platformVersion    PlatformVersion        @relation(fields: [platformVersionId], references: [id], onDelete: Restrict)
  outboxMessage      OutboxMessage?

  @@unique([publishingIntentId, platformVersionId])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, state, updatedAt(sort: Desc)])
  @@map("platform_executions")
}

model OutboxMessage {
  id                  String            @id @default(uuid()) @db.Uuid
  workspaceId         String            @map("workspace_id") @db.Uuid
  platformExecutionId String            @unique @map("platform_execution_id") @db.Uuid
  topic               String            @db.VarChar(120)
  state               OutboxState       @default(PENDING)
  attempt             Int               @default(0)
  availableAt         DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(3)
  claimOwner          String?           @map("claim_owner") @db.VarChar(160)
  claimUntil          DateTime?         @map("claim_until") @db.Timestamptz(3)
  claimGeneration     BigInt            @default(0) @map("claim_generation")
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  failureCategory     String?           @map("failure_category") @db.VarChar(80)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformExecution   PlatformExecution @relation(fields: [platformExecutionId], references: [id], onDelete: Cascade)

  @@index([state, availableAt, createdAt])
  @@index([workspaceId, state])
  @@map("outbox_messages")
}

model AuditEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventVersion  Int       @default(1) @map("event_version")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  workspaceId   String    @map("workspace_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  actorType     String    @map("actor_type") @db.VarChar(20)
  action        String    @db.VarChar(80)
  targetType    String    @map("target_type") @db.VarChar(40)
  targetId      String    @map("target_id") @db.VarChar(255)
  result        String    @db.VarChar(20)
  correlationId String    @map("correlation_id") @db.Uuid
  metadata      Json      @default("{}")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor         User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, action, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model DataDeletionRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  requestedByUserId    String?             @map("requested_by_user_id") @db.Uuid
  requesterReference   String?             @map("requester_reference") @db.VarChar(64)
  scope                String              @default("workspace_data") @db.VarChar(40)
  state                DataDeletionState   @default(PENDING)
  requestReference     String              @unique @map("request_reference") @db.VarChar(32)
  dataClasses          String[]            @default([]) @map("data_classes")
  pendingObjectKeys    String[]            @default([]) @map("pending_object_keys")
  failureCategory      String?             @map("failure_category") @db.VarChar(80)
  requestedAt          DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt            DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?           @map("completed_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  lifecycleOperationId String?             @unique @map("lifecycle_operation_id") @db.Uuid
  retentionExpiresAt   DateTime?           @map("retention_expires_at") @db.Timestamptz(3)
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lifecycleOperation   LifecycleOperation? @relation(fields: [lifecycleOperationId], references: [id], onDelete: Restrict)

  @@index([workspaceId, state, requestedAt(sort: Desc)])
  @@index([state, requestedAt])
  @@map("data_deletion_requests")
}

model LifecycleOperation {
  id                  String                  @id @default(uuid()) @db.Uuid
  kind                LifecycleOperationKind
  state               LifecycleOperationState @default(PENDING)
  workspaceId         String?                 @map("workspace_id") @db.Uuid
  channelId           String?                 @map("channel_id") @db.Uuid
  subjectUserId       String?                 @map("subject_user_id") @db.Uuid
  actorUserId         String?                 @map("actor_user_id") @db.Uuid
  dedupeKey           String                  @unique @map("dedupe_key") @db.VarChar(255)
  requestReference    String                  @unique @map("request_reference") @db.VarChar(40)
  correlationId       String                  @map("correlation_id") @db.Uuid
  requestedAt         DateTime                @default(now()) @map("requested_at") @db.Timestamptz(3)
  deadlineAt          DateTime                @map("deadline_at") @db.Timestamptz(3)
  nextAttemptAt       DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedBy           String?                 @map("claimed_by") @db.VarChar(160)
  claimedUntil        DateTime?               @map("claimed_until") @db.Timestamptz(3)
  claimGeneration     BigInt                  @default(0) @map("claim_generation")
  attempt             Int                     @default(0)
  failureCategory     String?                 @map("failure_category") @db.VarChar(80)
  outcome             Json                    @default("{}")
  completedAt         DateTime?               @map("completed_at") @db.Timestamptz(3)
  retentionExpiresAt  DateTime                @map("retention_expires_at") @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  steps               LifecycleStep[]
  dataDeletionRequest DataDeletionRequest?

  @@index([state, nextAttemptAt, requestedAt])
  @@index([workspaceId, kind, requestedAt(sort: Desc)])
  @@index([channelId, kind, requestedAt(sort: Desc)])
  @@map("lifecycle_operations")
}

model LifecycleStep {
  id              String             @id @default(uuid()) @db.Uuid
  operationId     String             @map("operation_id") @db.Uuid
  name            String             @db.VarChar(80)
  ordinal         Int
  state           LifecycleStepState @default(PENDING)
  attempt         Int                @default(0)
  claimGeneration BigInt             @default(0) @map("claim_generation")
  outcome         Json               @default("{}")
  failureCategory String?            @map("failure_category") @db.VarChar(80)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  operation       LifecycleOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, name])
  @@index([operationId, ordinal])
  @@map("lifecycle_steps")
}

model AccountAuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  eventVersion       Int      @default(1) @map("event_version")
  subjectReference   String   @map("subject_reference") @db.VarChar(80)
  actorReference     String?  @map("actor_reference") @db.VarChar(80)
  action             String   @db.VarChar(80)
  targetType         String   @map("target_type") @db.VarChar(40)
  targetId           String   @map("target_id") @db.VarChar(255)
  result             String   @db.VarChar(20)
  correlationId      String   @map("correlation_id") @db.Uuid
  metadata           Json     @default("{}")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  retentionExpiresAt DateTime @map("retention_expires_at") @db.Timestamptz(3)

  @@index([subjectReference, occurredAt(sort: Desc)])
  @@index([retentionExpiresAt])
  @@map("account_audit_events")
}
