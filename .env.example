NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3100
# Deployed processes set a role-specific immutable COS object version. The
# plaintext payload is loaded in memory after KMS decryption and is never kept
# in this file. Keep disabled for local development.
RUNTIME_SECRET_BUNDLE_ENABLED=false
RUNTIME_SECRET_BUNDLE_ROLE=platform
RUNTIME_SECRET_BUNDLE_BUCKET=
RUNTIME_SECRET_BUNDLE_VERSION_ID=
RUNTIME_SECRET_BUNDLE_REGION=ap-seoul
RUNTIME_SECRET_BUNDLE_ENDPOINT=
DATABASE_URL=postgresql://jingtang_app:local_app_only@localhost:5432/jingtang?schema=public
DATABASE_ADMIN_URL=postgresql://postgres:local_admin_only@localhost:5432/jingtang?schema=public
DATABASE_WORKER_URL=postgresql://jingtang_worker:local_worker_only@localhost:5432/jingtang?schema=public
ASYNC_TRANSPORT=local
TDMQ_AMQP_URL=
TDMQ_EXCHANGE=jingtang.commands.v1
TDMQ_QUEUE=jingtang.youtube.publish.v1
TDMQ_DEAD_LETTER_EXCHANGE=jingtang.dead-letter.v1
TDMQ_DEAD_LETTER_QUEUE=jingtang.youtube.publish.dlq.v1
IDENTITY_PROVIDER=mock
ALLOW_TEST_IDENTITY=true
LOCAL_IDENTITY_STORE_PATH=../../.local/mock-identity.json
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
CIAM_ISSUER=
CIAM_CLIENT_ID=
CIAM_CLIENT_SECRET=
CIAM_PASSWORD_AUTH_SOURCE_ID=
CIAM_USER_STORE_ID=
SESSION_COOKIE_SECRET=local-development-secret-change-me-32-bytes
TERMS_VERSION=2026-08-26
PRIVACY_VERSION=2026-08-26
DATA_PURPOSE_VERSION=2026-08-26
TERMS_URL=https://jingtangai.com/en/terms/
PRIVACY_URL=https://jingtangai.com/en/privacy/
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=ap-seoul
OBJECT_STORAGE_BUCKET=jingtang-source-assets
OBJECT_STORAGE_ACCESS_KEY_ID=jingtang_local
OBJECT_STORAGE_SECRET_ACCESS_KEY=local_storage_only_change_me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=false
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION_MODE=aes256
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=120000
MAX_SOURCE_ASSET_BYTES=262144000
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_STATE_SECRET=
YOUTUBE_TEST_FAULT=none
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_STATE_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
OAUTH_TOKEN_VAULT_PROVIDER=local
OAUTH_TOKEN_ENCRYPTION_KEY=
# Production/staging must use cvm_role; static is for local compatible services only.
TENCENT_CREDENTIAL_PROVIDER=static
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_KMS_REGION=ap-seoul
TENCENT_KMS_KEY_ID=
TENCENT_KMS_ENDPOINT=
OAUTH_TOKEN_KEY_STORAGE_BUCKET=
LOCAL_TOKEN_KEY_STORE_PATH=../../.local/oauth-token-keys.json
