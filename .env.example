NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3100
DATABASE_URL=postgresql://jingtang_app:local_app_only@localhost:5432/jingtang?schema=public
DATABASE_ADMIN_URL=postgresql://postgres:local_admin_only@localhost:5432/jingtang?schema=public
DATABASE_WORKER_URL=postgresql://jingtang_worker:local_worker_only@localhost:5432/jingtang?schema=public
IDENTITY_PROVIDER=mock
ALLOW_TEST_IDENTITY=true
LOCAL_IDENTITY_STORE_PATH=../../.local/mock-identity.json
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
CIAM_ISSUER=
CIAM_CLIENT_ID=
SESSION_COOKIE_SECRET=local-development-secret-change-me-32-bytes
TERMS_VERSION=2026-08-21
PRIVACY_VERSION=2026-08-21
DATA_PURPOSE_VERSION=2026-08-21
TERMS_URL=https://jingtangai.com/en/terms/
PRIVACY_URL=https://jingtangai.com/en/privacy/
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_BUCKET=jingtang-source-assets
OBJECT_STORAGE_ACCESS_KEY_ID=jingtang_local
OBJECT_STORAGE_SECRET_ACCESS_KEY=local_storage_only_change_me
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=false
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=120000
MAX_SOURCE_ASSET_BYTES=262144000
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_STATE_SECRET=
YOUTUBE_TEST_FAULT=none
OAUTH_TOKEN_VAULT_PROVIDER=local
OAUTH_TOKEN_ENCRYPTION_KEY=
LOCAL_TOKEN_KEY_STORE_PATH=../../.local/oauth-token-keys.json
