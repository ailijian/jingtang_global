{
  "name": "jingtang-global",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @jingtang/platform --filter @jingtang/worker dev",
    "build:packages": "pnpm --filter './packages/*' build",
    "dev:site": "pnpm --filter @jingtang/site dev",
    "clean:dev": "tsx scripts/clean-dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test:unit": "vitest run --config tests/vitest.unit.config.ts",
    "contracts:generate": "tsx scripts/generate-contract-types.ts",
    "test:contract": "tsx scripts/generate-contract-types.ts --check && tsx scripts/check-contracts.ts",
    "test:i18n": "vitest run --config tests/vitest.i18n.config.ts && tsx scripts/check-i18n.ts",
    "test:site": "tsx scripts/check-public-site.ts",
    "test:migration": "tsx scripts/test-migrations.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:e2e:platform": "tsx scripts/run-platform-e2e.ts",
    "test:e2e:site": "playwright test --config playwright.site.config.ts",
    "test:e2e": "pnpm test:e2e:platform && pnpm test:e2e:site",
    "test:security": "tsx scripts/scan-secrets.ts && pnpm audit --prod --audit-level high",
    "test:operations": "tsx scripts/check-d6-controls.ts && tsx scripts/test-backup-restore.ts",
    "infra:validate": "pnpm --filter @jingtang/infra validate",
    "saas:release-check": "tsx scripts/check-saas-release.ts",
    "review:release-check": "tsx scripts/check-review-release.ts",
    "verify": "pnpm format:check && pnpm build:packages && pnpm lint && pnpm typecheck && pnpm build && pnpm infra:validate && pnpm saas:release-check && pnpm test:unit && pnpm test:contract && pnpm test:i18n && pnpm test:site && pnpm test:migration && pnpm test:integration && pnpm test:e2e && pnpm test:operations && pnpm test:security",
    "site:release-check": "pnpm test:site -- --production",
    "site:production-smoke": "tsx scripts/smoke-public-site.ts",
    "site:deploy:tencent": "bash scripts/deploy-public-site-tencent.sh",
    "secrets:publish:tencent": "tsx scripts/publish-runtime-secret-bundle.ts",
    "db:generate": "pnpm --filter @jingtang/db db:generate",
    "db:migrate": "pnpm --filter @jingtang/db db:migrate",
    "db:studio": "pnpm --filter @jingtang/db db:studio",
    "local:up": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "local:down": "docker compose -f infra/local/docker-compose.yml down",
    "local:reset": "docker compose -f infra/local/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
