# Non-secret production bootstrap references only. The protected operator creates
# /srv/jingtang/saas/runtime.env with mode 0600. Never put plaintext credentials here.
RUNTIME_SECRET_BUNDLE_BUCKET=replace-with-private-versioned-secret-bucket
RUNTIME_SECRET_BUNDLE_ENDPOINT=https://cos.ap-seoul.myqcloud.com
PLATFORM_SECRET_VERSION_ID=replace-with-exact-platform-cos-version-id
DISPATCHER_SECRET_VERSION_ID=replace-with-exact-dispatcher-cos-version-id
WORKER_SECRET_VERSION_ID=replace-with-exact-worker-cos-version-id

OBJECT_STORAGE_BUCKET=replace-with-private-source-asset-bucket
OAUTH_TOKEN_KEY_STORAGE_BUCKET=replace-with-private-wrapped-key-bucket
TENCENT_KMS_KEY_ID=replace-with-oauth-envelope-kms-key-id

CIAM_ISSUER=https://replace-with-production-ciam-tenant
CIAM_CLIENT_ID=replace-with-production-ciam-client-id
CIAM_PASSWORD_AUTH_SOURCE_ID=replace-with-production-password-auth-source-id
CIAM_USER_STORE_ID=replace-with-production-user-store-id
YOUTUBE_OAUTH_CLIENT_ID=replace-with-production-google-oauth-client-id
