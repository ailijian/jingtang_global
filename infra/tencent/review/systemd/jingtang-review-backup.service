[Unit]
Description=Encrypted JINGTANG review PostgreSQL backup to COS
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/srv/jingtang/review/backup-review.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/jingtang/review/backup-work
TimeoutStartSec=30min
