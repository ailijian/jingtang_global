# Non-secret review deployment bootstrap. Install as /srv/jingtang/review/runtime.env (0600).
REVIEW_COS_BUCKET=jingtang-review-REPLACE_WITH_APP_ID
REVIEW_YOUTUBE_OAUTH_CLIENT_ID=REPLACE_WITH_REVIEW_CLIENT_ID
REVIEW_FACEBOOK_APP_ID=REPLACE_WITH_COMPANY_META_APP_ID
REVIEW_FACEBOOK_LOGIN_CONFIGURATION_ID=REPLACE_WITH_COMPANY_META_LOGIN_CONFIGURATION_ID

# Filled by the immutable release activation process.
JINGTANG_IMAGE=jingtang-review:REPLACE_WITH_FULL_GIT_SHA
JINGTANG_MIGRATION_IMAGE=jingtang-review-migration:REPLACE_WITH_FULL_GIT_SHA

# Required only for the operator-only identity provisioning service.
REVIEW_IDENTITY_EMAIL=developer@jingtangai.com
REVIEW_IDENTITY_NAME=JINGTANG Reviewer
